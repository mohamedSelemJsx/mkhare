# انسخ هذا الملف إلى .env واملأ القيم من لوحة Supabase (Project Settings → API)
# ⚠️ المفتاح anon عام بطبيعته — الأمان يكون عبر Row Level Security لا بإخفائه.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# كود يفتح لوحة المتابعة (لك أنت). أي نص تختاره — يُتحقق منه على المتصفح فقط (حماية خفيفة لـ v1).
VITE_ADMIN_CODE=changeme
